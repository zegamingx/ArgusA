#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer PackedTrainingBuffer {
    uint values[];
};

layout(push_constant) uniform LinearParameters {
    uint rowCount;
    uint batchCount;
    uint rowsPerBatch;
    uint inputColumns;
    uint outputColumns;
    uint inputOffset;
    uint weightOffset;
    uint outputOffset;
    uint transposeWeights;
} parameters;

float16_t loadHalf(uint halfIndex) {
    const vec2 pair = unpackHalf2x16(values[halfIndex >> 1u]);
    return float16_t((halfIndex & 1u) == 0u ? pair.x : pair.y);
}

void main() {
    const uint outputElementCount = parameters.rowCount * parameters.outputColumns;
    const uint invocationStride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;

    uint outputIndex = gl_GlobalInvocationID.x;
    while (outputIndex < outputElementCount) {
        const uint row = outputIndex / parameters.outputColumns;
        const uint column = outputIndex - row * parameters.outputColumns;
        const uint batchIndex = row / parameters.rowsPerBatch;
        if (batchIndex >= parameters.batchCount) {
            break;
        }

        const uint rowInBatch = row - batchIndex * parameters.rowsPerBatch;
        const uint inputRowOffset =
            parameters.inputOffset +
            batchIndex * parameters.rowsPerBatch * parameters.inputColumns +
            rowInBatch * parameters.inputColumns;
        const uint batchWeightOffset =
            parameters.weightOffset +
            batchIndex * parameters.inputColumns * parameters.outputColumns;

        float sum = 0.0;
        for (uint inner = 0u; inner < parameters.inputColumns; ++inner) {
            uint weightIndex;
            if (parameters.transposeWeights == 0u) {
                weightIndex = batchWeightOffset + inner * parameters.outputColumns + column;
            } else {
                weightIndex = batchWeightOffset + column * parameters.inputColumns + inner;
            }

            const float16_t inputValue = loadHalf(inputRowOffset + inner);
            const float16_t weightValue = loadHalf(weightIndex);
            sum += float(inputValue * weightValue);
        }

        values[parameters.outputOffset + outputIndex] = floatBitsToUint(sum);

        if (outputElementCount - outputIndex <= invocationStride) {
            break;
        }
        outputIndex += invocationStride;
    }
}
