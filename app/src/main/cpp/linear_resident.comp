#version 450

// Resident activation projection: FP32 activations, packed IEEE-754 FP16
// weights, and FP32 outputs. All tensors remain in the persistent Tensor Arena.
layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer TensorArena {
    uint values[];
};

layout(push_constant) uniform ResidentLinearParameters {
    uint inputBatchStrideWords;
    uint batchCount;
    uint rowsPerBatch;
    uint inputColumns;
    uint outputColumns;
    uint inputOffsetWords;
    uint weightOffsetHalf;
    uint outputOffsetWords;
    uint transposeWeights;
    uint reservedOffset;
} parameters;

const uint TILE_ROWS = 8u;
const uint TILE_COLUMNS = 16u;
const uint TILE_K = 16u;

shared float inputTile[TILE_ROWS][TILE_K];
shared float weightTile[TILE_K][TILE_COLUMNS];

float loadHalfAsFloat(uint halfIndex) {
    const vec2 pair = unpackHalf2x16(values[halfIndex >> 1u]);
    return (halfIndex & 1u) == 0u ? pair.x : pair.y;
}

void main() {
    const uint tilesPerRow =
        1u + (parameters.outputColumns - 1u) / TILE_COLUMNS;
    const uint tilesPerBatch =
        (1u + (parameters.rowsPerBatch - 1u) / TILE_ROWS) * tilesPerRow;
    const uint totalTileCount = parameters.batchCount * tilesPerBatch;
    const uint tileStride = gl_NumWorkGroups.x;

    const uint localColumn = gl_LocalInvocationID.x;
    const uint localRow = gl_LocalInvocationID.y;
    uint tileIndex = gl_WorkGroupID.x;

    while (tileIndex < totalTileCount) {
        const uint batchIndex = tileIndex / tilesPerBatch;
        const uint tileInBatch = tileIndex - batchIndex * tilesPerBatch;
        const uint tileRow = tileInBatch / tilesPerRow;
        const uint tileColumn = tileInBatch - tileRow * tilesPerRow;

        const uint rowInBatch = tileRow * TILE_ROWS + localRow;
        const uint outputColumn = tileColumn * TILE_COLUMNS + localColumn;
        const bool validOutputRow = rowInBatch < parameters.rowsPerBatch;
        const bool validOutputColumn = outputColumn < parameters.outputColumns;

        const uint globalRow = batchIndex * parameters.rowsPerBatch + rowInBatch;
        const uint inputBatchOffset =
            parameters.inputOffsetWords +
            batchIndex * parameters.inputBatchStrideWords +
            rowInBatch * parameters.inputColumns;
        const uint batchWeightOffsetHalf = parameters.batchCount > 1u
            ? values[parameters.reservedOffset + batchIndex]
            : parameters.weightOffsetHalf;

        float accumulated = 0.0;
        for (uint kBase = 0u; kBase < parameters.inputColumns; kBase += TILE_K) {
            const uint inputColumn = kBase + localColumn;
            if (validOutputRow && inputColumn < parameters.inputColumns) {
                inputTile[localRow][localColumn] =
                    uintBitsToFloat(values[inputBatchOffset + inputColumn]);
            } else {
                inputTile[localRow][localColumn] = 0.0;
            }

            // Each invocation loads two rows of the 16x16 weight tile.
            const uint weightK0 = kBase + localRow;
            const uint weightK1 = weightK0 + TILE_ROWS;
            if (validOutputColumn && weightK0 < parameters.inputColumns) {
                uint weightIndex0;
                if (parameters.transposeWeights == 0u) {
                    weightIndex0 =
                        batchWeightOffsetHalf +
                        weightK0 * parameters.outputColumns +
                        outputColumn;
                } else {
                    weightIndex0 =
                        batchWeightOffsetHalf +
                        outputColumn * parameters.inputColumns +
                        weightK0;
                }
                weightTile[localRow][localColumn] = loadHalfAsFloat(weightIndex0);
            } else {
                weightTile[localRow][localColumn] = 0.0;
            }

            if (validOutputColumn && weightK1 < parameters.inputColumns) {
                uint weightIndex1;
                if (parameters.transposeWeights == 0u) {
                    weightIndex1 =
                        batchWeightOffsetHalf +
                        weightK1 * parameters.outputColumns +
                        outputColumn;
                } else {
                    weightIndex1 =
                        batchWeightOffsetHalf +
                        outputColumn * parameters.inputColumns +
                        weightK1;
                }
                weightTile[weightK1 - kBase][localColumn] = loadHalfAsFloat(weightIndex1);
            } else {
                weightTile[weightK1 - kBase][localColumn] = 0.0;
            }

            barrier();

            for (uint k = 0u; k < TILE_K; ++k) {
                accumulated = fma(
                    inputTile[localRow][k],
                    weightTile[k][localColumn],
                    accumulated
                );
            }

            barrier();
        }

        if (validOutputRow && validOutputColumn) {
            const uint outputIndex =
                parameters.outputOffsetWords +
                globalRow * parameters.outputColumns +
                outputColumn;
            values[outputIndex] = floatBitsToUint(accumulated);
        }

        if (totalTileCount - tileIndex <= tileStride) {
            break;
        }
        tileIndex += tileStride;
    }
}
